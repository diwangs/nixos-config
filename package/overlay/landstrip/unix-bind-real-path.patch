+/// Path the broker binds on behalf of the target.
+///
+/// The kernel records `sun_path` verbatim, so binding through the anchor's
+/// `/proc/self/fd/N/<name>` leaks that broker-local path into the target's
+/// `getsockname(2)`. Programs that advertise their listener address to a peer
+/// (e.g. go-plugin / Terraform providers) then hand out a path the peer cannot
+/// dial. Prefer the resolved absolute path when the target shares the
+/// broker's root and its parent is still the directory the anchor pins;
+/// otherwise fall back to the anchor path.
+fn unix_bind_path(label: &Path, root: BorrowedFd<'_>, anchor: &Anchor) -> SysResult<PathBuf> {
+    let max_path = mem::size_of::<libc::sockaddr_un>() - mem::size_of::<libc::sa_family_t>();
+    let shares_root = same_inode(root, Path::new("/"));
+    let same_parent = label
+        .parent()
+        .is_some_and(|parent| same_inode(anchor.dir.as_fd(), parent));
+    if label.is_absolute()
+        && label.as_os_str().len() < max_path
+        && shares_root
+        && same_parent
+    {
+        return Ok(label.to_path_buf());
+    }
+    let broker_path = anchor.path()?;
+    Ok(PathBuf::from(OsStr::from_bytes(broker_path.as_bytes())))
+}
+
+fn same_inode(left: BorrowedFd<'_>, right: &Path) -> bool {
+    let (Ok(stat), Ok(right)) = (fstat(left), fs::metadata(right)) else {
+        return false;
+    };
+    stat.st_dev == right.dev() && stat.st_ino == right.ino()
+}
