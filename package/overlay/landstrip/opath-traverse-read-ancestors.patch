+    /// Whether `canonical` may be opened as an `O_PATH | O_DIRECTORY`
+    /// traversal handle even though it is not under a read root itself.
+    ///
+    /// Splitting `/` around read denials leaves the directories on the way to
+    /// those denials (`/`, `/home`, `/run/user/1000`, ...) outside every read
+    /// root. Such a handle exposes no data: it only anchors `*at` calls, which
+    /// are mediated on their own, and `O_DIRECTORY` keeps it off regular files
+    /// that could otherwise be hardlinked elsewhere and read.
+    pub(crate) fn read_traversal_allowed(&self, canonical: &Path, lexical: &Path) -> bool {
+        match &self.read_access {
+            ReadAccess::Unrestricted => true,
+            ReadAccess::AllowRoots(roots) => {
+                !self.read_denials.is_denied_pair(canonical, lexical)
+                    && roots.iter().any(|root| root.is_strictly_under(canonical))
+            }
+        }
+    }
+
