+/* map /dev/mapper/<name> to its kernel block name by matching dm/name in sysfs */
+static gchar *
+fu_linux_swap_block_name_for_dm_name(FuPathStore *pstore, const gchar *dm_name, GError **error)
+{
+	const gchar *child;
+	g_autofree gchar *block_path = NULL;
+	g_autoptr(GDir) dir = NULL;
+
+	block_path = fu_path_store_build_filename(pstore,
+						  error,
+						  FU_PATH_KIND_SYSFSDIR,
+						  "class",
+						  "block",
+						  NULL);
+	if (block_path == NULL)
+		return NULL;
+	dir = g_dir_open(block_path, 0, error);
+	if (dir == NULL)
+		return NULL;
+	while ((child = g_dir_read_name(dir)) != NULL) {
+		g_autofree gchar *name_path = NULL;
+		g_autofree gchar *name = NULL;
+
+		name_path = g_build_filename(block_path, child, "dm", "name", NULL);
+		if (!g_file_get_contents(name_path, &name, NULL, NULL))
+			continue;
+		g_strstrip(name);
+		if (g_strcmp0(name, dm_name) == 0)
+			return g_strdup(child);
+	}
+	g_set_error(error,
+		    FWUPD_ERROR,
+		    FWUPD_ERROR_NOT_FOUND,
+		    "no device-mapper node named %s",
+		    dm_name);
+	return NULL;
+}
+
+/* map a block device path to its kernel block name (e.g. dm-1); st_rdev resolves
+ * /dev/mapper/<name> symlinks, then dm/name is matched in sysfs, and finally the
+ * basename is used, which only matches /dev/<kernel-name> */
+static gchar *
+fu_linux_swap_block_name_for_path(FuPathStore *pstore, const gchar *devpath)
+{
+	gchar *name = NULL;
+	g_autoptr(GFile) gfile = g_file_new_for_path(devpath);
+	g_autoptr(GFileInfo) info = NULL;
+	g_autoptr(GError) error_rdev = NULL;
+
+	info = g_file_query_info(gfile,
+				 G_FILE_ATTRIBUTE_UNIX_RDEV,
+				 G_FILE_QUERY_INFO_NONE,
+				 NULL,
+				 &error_rdev);
+	if (info == NULL) {
+		g_debug("could not query rdev for %s: %s", devpath, error_rdev->message);
+	} else {
+		guint32 rdev = g_file_info_get_attribute_uint32(info, G_FILE_ATTRIBUTE_UNIX_RDEV);
+		if (rdev != 0) {
+			g_autoptr(GError) error_name = NULL;
+			name = fu_linux_swap_block_name_for_devnum(pstore, rdev, &error_name);
+			if (name != NULL)
+				return name;
+			g_debug("st_rdev mapping failed for %s: %s", devpath, error_name->message);
+		}
+	}
+	if (g_str_has_prefix(devpath, "/dev/mapper/")) {
+		g_autoptr(GError) error_dm = NULL;
+		name = fu_linux_swap_block_name_for_dm_name(pstore,
+							    devpath + strlen("/dev/mapper/"),
+							    &error_dm);
+		if (name != NULL)
+			return name;
+		g_debug("dm/name mapping failed for %s: %s", devpath, error_dm->message);
+	}
+	name = g_path_get_basename(devpath);
+	g_debug("falling back to basename %s", name);
+	return name;
+}
+
+/* undo the octal escaping the kernel applies to space, tab, newline and backslash */
+static gchar *
+fu_linux_swap_mountinfo_unescape(const gchar *str)
+{
+	GString *out = g_string_new(NULL);
+	for (guint i = 0; str[i] != '\0'; i++) {
+		if (str[i] == '\\' && str[i + 1] >= '0' && str[i + 1] <= '3' && str[i + 2] >= '0' &&
+		    str[i + 2] <= '7' && str[i + 3] >= '0' && str[i + 3] <= '7') {
+			g_string_append_c(out,
+					  (gchar)(((str[i + 1] - '0') << 6) |
+						  ((str[i + 2] - '0') << 3) | (str[i + 3] - '0')));
+			i += 3;
+			continue;
+		}
+		g_string_append_c(out, str[i]);
+	}
+	return g_string_free(out, FALSE);
+}
+
+/* TRUE if @mountpoint contains @fn, matching on whole path components */
+static gboolean
+fu_linux_swap_mountpoint_contains(const gchar *mountpoint, const gchar *fn)
+{
+	gsize len = strlen(mountpoint);
+	if (g_strcmp0(mountpoint, "/") == 0)
+		return fn[0] == '/';
+	if (strncmp(fn, mountpoint, len) != 0)
+		return FALSE;
+	return fn[len] == '\0' || fn[len] == '/';
+}
+
+/* find the source block device of the mount containing @fn; some filesystems
+ * (e.g. btrfs subvolumes) report an anonymous st_dev with no backing block
+ * device in sysfs, so match on the most specific mount point instead */
+gchar *
+fu_linux_swap_mount_source_for_path(FuPathStore *pstore, const gchar *fn, GError **error)
+{
+	gsize best_len = 0;
+	g_autofree gchar *best_source = NULL;
+	g_autofree gchar *best_mountpoint = NULL;
+	g_autofree gchar *buf = NULL;
+	g_autofree gchar *mountinfo_path = NULL;
+	g_auto(GStrv) lines = NULL;
+
+	g_return_val_if_fail(pstore != NULL, NULL);
+	g_return_val_if_fail(fn != NULL, NULL);
+	g_return_val_if_fail(error == NULL || *error == NULL, NULL);
+
+	mountinfo_path = fu_path_store_build_filename(pstore,
+						      error,
+						      FU_PATH_KIND_PROCFS,
+						      "self",
+						      "mountinfo",
+						      NULL);
+	if (mountinfo_path == NULL)
+		return NULL;
+	if (!g_file_get_contents(mountinfo_path, &buf, NULL, error))
+		return NULL;
+
+	/* ID PARENT MAJ:MIN ROOT MOUNTPOINT OPTS [OPTIONAL...] - FSTYPE SOURCE SUPEROPTS */
+	lines = g_strsplit(buf, "\n", -1);
+	for (guint i = 0; lines[i] != NULL; i++) {
+		guint sep = 0;
+		gsize len;
+		g_auto(GStrv) fields = g_strsplit(lines[i], " ", -1);
+		g_autofree gchar *mountpoint = NULL;
+
+		if (g_strv_length(fields) < 10)
+			continue;
+		for (guint j = 6; fields[j] != NULL; j++) {
+			if (g_strcmp0(fields[j], "-") == 0) {
+				sep = j;
+				break;
+			}
+		}
+		if (sep == 0 || fields[sep + 1] == NULL || fields[sep + 2] == NULL)
+			continue;
+		mountpoint = fu_linux_swap_mountinfo_unescape(fields[4]);
+		if (!fu_linux_swap_mountpoint_contains(mountpoint, fn))
+			continue;
+
+		/* most specific wins; on a tie the later (over-)mount wins */
+		len = strlen(mountpoint);
+		if (len < best_len)
+			continue;
+		best_len = len;
+		g_free(best_mountpoint);
+		best_mountpoint = g_steal_pointer(&mountpoint);
+		g_free(best_source);
+		best_source = fu_linux_swap_mountinfo_unescape(fields[sep + 2]);
+	}
+	if (best_source == NULL) {
+		g_set_error(error,
+			    FWUPD_ERROR,
+			    FWUPD_ERROR_NOT_FOUND,
+			    "no mount found containing %s",
+			    fn);
+		return NULL;
+	}
+	if (!g_str_has_prefix(best_source, "/dev/")) {
+		g_set_error(error,
+			    FWUPD_ERROR,
+			    FWUPD_ERROR_NOT_SUPPORTED,
+			    "mount %s for %s has non-block source %s",
+			    best_mountpoint,
+			    fn,
+			    best_source);
+		return NULL;
+	}
+	g_debug("%s is on mount %s from %s", fn, best_mountpoint, best_source);
+	return g_steal_pointer(&best_source);
+}
