+static void
+fu_linux_swap_btrfs_fixture(FuPathStore *pstore)
+{
+	g_autofree gchar *procdir = NULL;
+	g_autofree gchar *rootdir = NULL;
+	g_autofree gchar *sysdir = NULL;
+
+	procdir = g_test_build_filename(G_TEST_DIST, "tests", "btrfs-on-luks", "proc", NULL);
+	rootdir = g_test_build_filename(G_TEST_DIST, "tests", "btrfs-on-luks", "root", NULL);
+	sysdir = g_test_build_filename(G_TEST_DIST, "tests", "btrfs-on-luks", "sys", NULL);
+	fu_path_store_set_path(pstore, FU_PATH_KIND_PROCFS, procdir);
+	fu_path_store_set_path(pstore, FU_PATH_KIND_HOSTFS_ROOT, rootdir);
+	fu_path_store_set_path(pstore, FU_PATH_KIND_SYSFSDIR, sysdir);
+}
+
+static void
+fu_linux_swap_mountinfo_func(void)
+{
+	g_autoptr(FuPathStore) pstore = fu_path_store_new();
+	struct {
+		const gchar *fn;
+		const gchar *source;
+	} map[] = {
+	    {"/var/swap/swapfile", "/dev/mapper/crypt-root"},
+	    {"/var/swap", "/dev/mapper/crypt-root"},
+	    {"/var/swapx/swapfile", "/dev/mapper/plain-root"},
+	    {"/mnt/with space/swapfile", "/dev/sdb1"}, /* octal-escaped mount point */
+	    {"/srv/swapfile", "/dev/sdd1"},	       /* last over-mount wins */
+	    {NULL, NULL},
+	};
+
+	fu_linux_swap_btrfs_fixture(pstore);
+	for (guint i = 0; map[i].fn != NULL; i++) {
+		g_autofree gchar *source = NULL;
+		g_autoptr(GError) error = NULL;
+
+		source = fu_linux_swap_mount_source_for_path(pstore, map[i].fn, &error);
+		g_assert_no_error(error);
+		g_assert_cmpstr(source, ==, map[i].source);
+	}
+}
+
+static void
+fu_linux_swap_mountinfo_no_block_func(void)
+{
+	g_autofree gchar *source = NULL;
+	g_autoptr(FuPathStore) pstore = fu_path_store_new();
+	g_autoptr(GError) error = NULL;
+
+	/* must not prefix-match /var/swap; falls through to the tmpfs root */
+	fu_linux_swap_btrfs_fixture(pstore);
+	source = fu_linux_swap_mount_source_for_path(pstore, "/var/swapy/swapfile", &error);
+	g_assert_error(error, FWUPD_ERROR, FWUPD_ERROR_NOT_SUPPORTED);
+	g_assert_null(source);
+}
+
+/* a swapfile on a btrfs subvolume has an anonymous st_dev with no sysfs block
+ * device, so the backing LUKS device must be found via the mount source */
+static void
+fu_linux_swap_btrfs_on_luks_func(void)
+{
+	g_autoptr(FuLinuxSwap) swap = NULL;
+	g_autoptr(FuPathStore) pstore = fu_path_store_new();
+	g_autoptr(GError) error = NULL;
+
+	fu_linux_swap_btrfs_fixture(pstore);
+	swap =
+	    fu_linux_swap_new(pstore,
+			      "Filename\t\t\t\tType\t\tSize\tUsed\tPriority\n"
+			      "/var/swap/swapfile                      file\t\t67108860\t0\t-2\n",
+			      0,
+			      &error);
+	g_assert_no_error(error);
+	g_assert_nonnull(swap);
+	g_assert_true(fu_linux_swap_get_enabled(swap));
+	g_assert_true(fu_linux_swap_get_encrypted(swap));
+}
